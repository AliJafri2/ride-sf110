<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>corina</groupId>
    <artifactId>corina</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Corina</name>
    <description>Corina dendrochronology application from the SF110 corpus</description>

    <properties>
        <project.build.sourceEncoding>iso-8859-1</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- Maven Central dependencies -->

        <!-- iText 1.3 (com.lowagie.text) -->
        <dependency>
            <groupId>com.lowagie</groupId>
            <artifactId>itext</artifactId>
            <version>1.3</version>
        </dependency>

        <!-- Commons Logging 1.0.4 -->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <version>1.0.4</version>
        </dependency>

        <!-- Log4j 1.2.8 (runtime, loapded via commons-logging) -->
        <dependency>
            <groupId>log4j</groupId>
            <artifactId>log4j</artifactId>
            <version>1.2.8</version>
        </dependency>

        <!-- Local repo dependencies (not available on Maven Central) -->

        <!-- JFontChooser (com.ozten.font) -->
        <dependency>
            <groupId>com.ozten</groupId>
            <artifactId>jfontchooser</artifactId>
            <version>local</version>
        </dependency>

        <!-- javax.comm (Sun Java Communications API) -->
        <dependency>
            <groupId>javax.comm</groupId>
            <artifactId>comm</artifactId>
            <version>local</version>
        </dependency>

        <!-- Smooth Metal Look and Feel -->
        <dependency>
            <groupId>smooth</groupId>
            <artifactId>smoothmetal</artifactId>
            <version>local</version>
        </dependency>

        <!-- edtFTPj (com.enterprisedt.net.ftp) -->
        <dependency>
            <groupId>com.enterprisedt</groupId>
            <artifactId>edtftpj</artifactId>
            <version>local</version>
        </dependency>

        <!-- RXTX serial communication (gnu.io) -->
        <dependency>
            <groupId>org.rxtx</groupId>
            <artifactId>rxtxcomm</artifactId>
            <version>local</version>
        </dependency>

        <!-- Apache Batik SVG (bundled single jar) -->
        <dependency>
            <groupId>org.apache.batik</groupId>
            <artifactId>batik-all</artifactId>
            <version>local</version>
        </dependency>

        <!-- Apache Avalon Framework (transitive dep for FOP) -->
        <dependency>
            <groupId>org.apache</groupId>
            <artifactId>avalon-framework</artifactId>
            <version>local</version>
        </dependency>

        <!-- Apache FOP -->
        <dependency>
            <groupId>org.apache.fop</groupId>
            <artifactId>fop</artifactId>
            <version>local</version>
        </dependency>

        <!-- JFor (XSL-FO to RTF) -->
        <dependency>
            <groupId>net.sf.jfor</groupId>
            <artifactId>jfor</artifactId>
            <version>local</version>
        </dependency>

        <!-- Apache Crimson XML parser -->
        <dependency>
            <groupId>crimson</groupId>
            <artifactId>crimson</artifactId>
            <version>local</version>
        </dependency>

        <!-- GNU JAXP -->
        <dependency>
            <groupId>gnu</groupId>
            <artifactId>gnujaxp</artifactId>
            <version>local</version>
        </dependency>

        <!-- Apache BCEL -->
        <dependency>
            <groupId>org.apache.bcel</groupId>
            <artifactId>bcel</artifactId>
            <version>local</version>
        </dependency>

        <!-- BeanShell -->
        <dependency>
            <groupId>bsh</groupId>
            <artifactId>bsh</artifactId>
            <version>local</version>
        </dependency>

        <!-- FindBugs -->
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>findbugs</artifactId>
            <version>local</version>
        </dependency>

        <!-- JavaHelp (jh.jar) -->
        <dependency>
            <groupId>javax.help</groupId>
            <artifactId>javahelp-jh</artifactId>
            <version>local</version>
        </dependency>

        <!-- JavaHelp (jhall.jar) -->
        <dependency>
            <groupId>javax.help</groupId>
            <artifactId>javahelp</artifactId>
            <version>local</version>
        </dependency>

        <!-- Java Look and Feel Graphics Repository -->
        <dependency>
            <groupId>com.sun</groupId>
            <artifactId>jlfgr</artifactId>
            <version>local</version>
        </dependency>

        <!-- Jython -->
        <dependency>
            <groupId>org.python</groupId>
            <artifactId>jython</artifactId>
            <version>local</version>
        </dependency>

        <!-- Kawa (Scheme on JVM) -->
        <dependency>
            <groupId>kawa</groupId>
            <artifactId>kawa</artifactId>
            <version>local</version>
        </dependency>

        <!-- Saxon XSLT processor -->
        <dependency>
            <groupId>net.sf.saxon</groupId>
            <artifactId>saxon</artifactId>
            <version>local</version>
        </dependency>

        <!-- Apache Xalan XSLT -->
        <dependency>
            <groupId>xalan</groupId>
            <artifactId>xalan</artifactId>
            <version>local</version>
        </dependency>

        <!-- Test dependencies -->

        <!-- JUnit 4.11 -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.11</version>
            <scope>test</scope>
        </dependency>

        <!-- EvoSuite runtime (for EvoSuiteRunner in generated tests) -->
        <dependency>
            <groupId>org.evosuite</groupId>
            <artifactId>evosuite</artifactId>
            <version>local</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <!-- Project-local repository for JARs not available on Maven Central -->
        <repository>
            <id>project-local</id>
            <url>file://${project.basedir}/repo</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <encoding>iso-8859-1</encoding>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
                <configuration>
                    <!-- Some EvoSuite tests may fail due to GUI/environment dependencies -->
                    <testFailureIgnore>true</testFailureIgnore>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
